{
  "height": 35,
  "layer": "top",
  "spacing": 0,
  "modules-left": ["hyprland/workspaces", "mpris"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "pulseaudio", "network", "battery"],
  "hyprland/workspaces": {
    "format": "{name}"
  },
  "mpris": {
    "format": " {player_icon} {dynamic} ",
    "format-paused": " {status_icon} {dynamic} ",
    "dynamic-order": ["title", "artist"],
    "smooth-scrolling-threshold": 1,
    "title-len": 15,
    "player-icons": {
      "chromium": "",
      "default": "",
      "firefox": "",
      "mopidy": "",
      "mpv": "󰐹",
      "spotify": "",
      "vlc": "󰕼"
    },
    "status-icons": {
      "paused": "󰐎",
      "playing": "",
      "stopped": ""
    }
  },
  "cpu": {
    "interval": 1,
    "format": "{icon} {usage}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "on-click": "exec wezterm start btop"
  },
  "memory": {
    "interval": 1,
    "format": " {used:0.1f}G/{total:0.1f}G ",
    "on-click": "exec wezterm start htop"
  },
  "network": {
    "interval": 1,
    "format": "",
    "format-wifi": "",
    "format-ethernet": "{bandwidthTotalBits} 󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "󰖪",
    "max-length": 50,
    "on-click": "exec nm-connection-editor"
  },
  "clock": {
    "timezone": "America/Fortaleza",
    "tooltip-format": "<span size='15pt'>{calendar}</span>",
    "format": " {:%H:%M %p %d %b %Y}",
    "calendar": {
      "format": {
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  },
  "battery": {
    "interval": 2,
    "states": {
      "good": 95,
      "warning": 40,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "rotate": 0,
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  }
}
